# Copy to .env.development.local for the development paper account.
# Production uses .env.competition.local and is read-only until acceptance passes.
APP_ENV=development
ACCOUNT_ROLE=development
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true
ALPACA_EXPECTED_ACCOUNT_ID=
APCA_API_BASE_URL=https://paper-api.alpaca.markets
ALPACA_TOOLSETS=account,trading,assets,stock-data,options-data,news
CLIENT_ORDER_PREFIX=mm-dev
DATABASE_URL=sqlite:///./money_machine.db
MODEL_PROVIDER=replay
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
MCP_COMMAND=alpaca-mcp-server
MCP_ARGS=
LOG_LEVEL=INFO
MISSION_CONTROL_URL=
MISSION_CONTROL_PROJECT=alpaca-competition
MISSION_CONTROL_TOKEN=
MISSION_CONTROL_REPORTING_INTERVAL_MINUTES=60
MISSION_CONTROL_ENVIRONMENT=development
